# Copy to .env.local to override. Defaults are set for "no backend running yet".
#
# WARNING: every VITE_ variable is inlined into the client bundle in plain text
# and is readable by anyone who opens the page. Never put a secret here.

# 'false' switches the API layer from fixtures to real HTTP. Anything else mocks.
VITE_USE_MOCKS=true

# Origin of the backend. Only read when VITE_USE_MOCKS=false.
#
# For local development point this at the DEV SERVER ITSELF -
# http://localhost:5173 - not at the backend. vite.config.ts proxies /api and
# /ws through to it, which makes every call same-origin. That matters because
# the backend installs no CORS middleware, so a direct call to :8000 is blocked
# by the browser before it is even sent.
VITE_API_BASE_URL=

# Which fixture variant to serve: normal | empty | large | error.
VITE_MOCK_SCENARIO=normal

# The login route guard. Only the exact string 'false' turns it OFF; unset means
# ON, so a missing .env file cannot silently unlock the app.
#
# Works on fixtures as well as a real backend, so leaving it on is safe in both
# modes. On VITE_USE_MOCKS=true any email and password are accepted and sign you
# in as the fixture manager - the fixtures exercise the session plumbing, they
# are not a security boundary.
#
# Note: the access token is held in memory only (see SECURITY.md), so reloading
# the page signs you out and returns you here. That is the storage decision, not
# a bug in the guard.
VITE_AUTH_ENFORCED=true

# Origin of WS /ws/attendance. Defaults to VITE_API_BASE_URL with http -> ws,
# which is right whenever the socket is served from the same origin.
VITE_WS_BASE_URL=

# Set to 'query' to enable the attendance WebSocket. Anything else leaves it off.
#
# A browser cannot set an Authorization header on a WebSocket handshake, so the
# token has to travel another way. Tested against the running backend: the query
# parameter is the only mechanism it accepts - a subprotocol handshake and an
# Authorization header both get a 403.
#
# Left off by default so the socket says "Not connected" rather than retrying
# against a backend that isn't there. Turn it on once you have one running.
VITE_WS_AUTH_MODE=

# Query parameter name. Verified as `token` against the backend.
VITE_WS_AUTH_QUERY_PARAM=token
