APP_NAME=Systeme de Gestion des Agences & IoT
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:mot_de_passe@localhost:5432/agence_iot
SECRET_KEY=change_me_in_local_env
ACCESS_TOKEN_EXPIRE_MINUTES=30

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

REDIS_URL=redis://localhost:6379/0

AI_SERVICE_URL=http://127.0.0.1:8001
AI_ALERTS_ENABLED=true
AI_RECONNECT_DELAY_SECONDS=5
AI_SOURCE_SYNC_INTERVAL_SECONDS=15

# MQ2 raw ADC calibration. Keep disabled until the real sensor is calibrated.
MQ2_RAW_TO_PPM_ENABLED=false
MQ2_RAW_BASELINE=0
MQ2_RAW_PPM_SCALE=1
MQ2_RAW_PPM_OFFSET=0

# CRITICAL-alert notifications. Web Push needs a VAPID key pair (generate with
# py_vapid; the public key is served to the dashboard, the private one never
# leaves the backend). Email is the fallback for users with no push
# subscription and is skipped entirely while SMTP_HOST is empty.
NOTIFICATIONS_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartagency.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@smartagency.local
SMTP_USE_TLS=true

# Health monitor: raises a CRITICAL alert when the AI service or the MQTT broker
# has been unreachable for longer than the grace period (so a restart or a blip
# pages nobody), and resolves it on recovery. The AI probe is skipped while
# AI_ALERTS_ENABLED is false.
HEALTH_MONITOR_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_DOWN_GRACE_SECONDS=45

# Device uptime history: devices with a heartbeat_seconds are sampled this
# often, counted online if heard from within this many heartbeats, and samples
# are kept for this many days.
DEVICE_SAMPLE_INTERVAL_SECONDS=300
DEVICE_MISSED_HEARTBEATS=3
DEVICE_SAMPLE_RETENTION_DAYS=90

# Limits on proxied AI WebSocket streams.
AI_WS_MAX_CONNECTIONS=50
AI_WS_MAX_CONNECTIONS_PER_USER=5

# Manual controls: how long a command waits for the device's ack. The commands
# each device type accepts come from contracts/device-commands.json unless
# DEVICE_COMMANDS_FILE points elsewhere.
MANUAL_CONTROL_ACK_TIMEOUT_SECONDS=10
DEVICE_COMMANDS_FILE=

# Badge + face doors: how long the door camera looks for the badge holder's
# face. The door reader's own HTTP timeout must be a few seconds longer.
DOOR_FACE_TIMEOUT_SECONDS=4

# People tracking and restricted zones: tracked positions older than this are
# dropped; how long someone may stand in a restricted zone before the alert;
# when a new track inherits a lost employee (seconds, floor centimetres).
PEOPLE_TRACKS_STALE_SECONDS=5
ZONE_INTRUSION_GRACE_SECONDS=5
ZONE_HANDOFF_SECONDS=2
ZONE_HANDOFF_DISTANCE=100
